# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
*.local

# Runtime data (self-hosted store) — re-seeded from the static catalog
data/
# …but the SEEDED catalog lives in src/data/ and must be committed.
!src/data/

# Environment — secrets live in .env.local (dev) or platform env vars (prod).
# .env is ignored too: it has contained real keys before and must never be
# committed. Public template lives in .env.example.
.env
.env.local
.env.*.local
!.env.example

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Recovery watcher runtime state (its .log variants are covered by *.log above)
.liveness-watch.lock
.liveness-watch.pid

# SFX bulk import scratch (extracted zip files + progress log)
.sfx-import-tmp/
.sfx-import.log

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
