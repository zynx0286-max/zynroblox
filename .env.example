# Copy to .env.local (dev) or set as secrets in the Cloudflare dashboard
# (Workers & Pages → Settings → Variables and Secrets) for production.
# Never commit real values to git.

# REQUIRED — admin sign-in password. No default: login fails closed without it.
ADMIN_PASSWORD="change-me-to-a-long-random-password"

# Admin login geo-fence (Franklin Township, NJ + nearby).
# soft = block logins positively outside the area, allow when location unknown
# strict = also block when location can't be determined
# off = disable (emergency kill switch)
ADMIN_GEO_ENFORCE="soft"

# Radius in miles around Franklin Township, NJ.
ADMIN_GEO_RADIUS_MILES="60"

# OPTIONAL — Supabase Postgres backend (primary when both are set).
# Without these the site uses Cloudflare KV exactly as before.
# Use the service_role secret (sb_secret_… or the eyJ… service_role JWT),
# NEVER the publishable/anon key. Create the supabase_kv table first with
# scripts/supabase-setup.sql. Ignored in local dev (NODE_ENV=development).
SUPABASE_URL=""
SUPABASE_SERVICE_KEY=""

# OPTIONAL — Discord DM bot (npm run bot, see docs/discord-bot.md).
# Token from the Discord developer portal (Bot tab). DISCORD_BOT_SECRET must
# hold the SAME value as the Worker secret of that name (generate:
#   node -e "console.log(crypto.randomBytes(32).toString('hex'))"  ).
DISCORD_BOT_TOKEN=""
DISCORD_BOT_SECRET=""

# OPTIONAL — proactive notifications from the Worker (see docs/maintenance.md).
# The nightly refresh and the weekly digest DM you when nothing else is
# running, so they can't reply in the conversation like the local bot does.
# DISCORD_BOT_TOKEN is set as a Worker secret too — the Worker reuses the same
# token to DM you, and finds your DM channel automatically (no user id needed).
# Upload it without ever printing it:
#   grep DISCORD_BOT_TOKEN .env.local | cut -d= -f2- | npx wrangler secret put DISCORD_BOT_TOKEN
#
# DISCORD_ANNOUNCE_WEBHOOK_URL posts "new entry" cards to a channel instead of
# (or as well as) a DM. Create one in Discord: Server Settings → Integrations →
# Webhooks. Leave empty to DM only.
DISCORD_ANNOUNCE_WEBHOOK_URL=""
