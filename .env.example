# Copy to .env.local (dev) or set as secrets in the Cloudflare dashboard
# (Workers & Pages → Settings → Variables and Secrets) for production.
# Never commit real values to git.

# REQUIRED — admin sign-in password. No default: login fails closed without it.
ADMIN_PASSWORD="change-me-to-a-long-random-password"

# Admin login geo-fence (Franklin Township, NJ + nearby).
# soft = block logins positively outside the area, allow when location unknown
# strict = also block when location can't be determined
# off = disable (emergency kill switch)
ADMIN_GEO_ENFORCE="soft"

# Radius in miles around Franklin Township, NJ.
ADMIN_GEO_RADIUS_MILES="60"
